# Server configuration
PORT=3001

# SQLite persistence (set file path to enable persistent storage; leave unset for in-memory mode)
SQLITE_DB_PATH=your_sqlite_database_file_path_here

# Docker Engine API (configure DOCKER_HOST or DOCKER_SOCKET_PATH; leave unset for unconfigured mode)
DOCKER_HOST=your_docker_proxy_url_here
DOCKER_SOCKET_PATH=your_docker_socket_path_here
DOCKER_TIMEOUT_MS=5000

# Uptime Kuma Status Page API (configure UPTIME_KUMA_URL and UPTIME_KUMA_SLUG; leave unset for unconfigured mode)
UPTIME_KUMA_URL=your_uptime_kuma_url_here
UPTIME_KUMA_SLUG=your_uptime_kuma_status_page_slug_here
UPTIME_KUMA_TIMEOUT_MS=5000

# n8n REST API (configure N8N_URL and N8N_API_KEY; leave unset for unconfigured mode)
N8N_URL=your_n8n_url_here
N8N_API_KEY=your_n8n_api_key_here
N8N_TIMEOUT_MS=5000
